# NEXORA deployment packaging
# Only what's needed to run the app. data/, models/, outputs/ artifacts
# are regenerated by build_pipeline.py on the server (or mounted as volumes).

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

.git/
.gitignore
*.md
Dockerfile
.dockerignore
docs/
notebooks/
logs_*.txt
.streamlit/secrets.toml
outputs/screenshots/
backend/

# Heavy artifacts stay out of the image by default:
data/processed/*.npz
models/seq2seq/*.pt
models/seq2seq/*.npy
models/m2m100/